  "issues": {
    "audio_sense_disabled": {
      "title": "Audio detection is turned off on {matrix}",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "Turn on audio sense",
            "description": "Audio-sense entities are enabled for this matrix, but it is not measuring, so they will stay unavailable.\n\nThe device reports the same value for \"no audio\" and \"not measuring\", so this cannot be shown as simply off without asserting something the hardware has not determined.\n\nSubmit to turn measuring on. If you did not intend to use audio sense, disable those entities instead and this will clear on its own."
          }
        },
        "abort": {
          "entry_unavailable": "That matrix is no longer set up, so there is nothing to change.",
          "cannot_enable": "The matrix did not accept the command. Check that it is reachable and try again."
        }
      }
    }
  },
  "services": {
    "set_eq_band": {
      "name": "Set EQ band",
      "description": "Set a band's frequency, gain and Q together. Omitted values are left alone, and the band is re-read once at the end rather than after each parameter.",
      "fields": {
        "frequency": {
          "name": "Frequency",
          "description": "Centre frequency in Hz. Snapped to the nearest band the matrix offers."
        },
        "gain": {
          "name": "Gain",
          "description": "Band gain in dB, -12 to +12."
        },
        "q": {
          "name": "Q",
          "description": "Band Q. The matrix offers 0.5, 0.6, 0.7, 0.8, 0.9, 1, 2 and 3."
        }
      }
    },
    "apply_eq_preset": {
      "name": "Apply EQ preset",
      "description": "Set all five equaliser bands of a zone in one step, using a ready-made preset. For your own settings, use a script that calls this or Set equaliser band.",
      "fields": {
        "preset": {
          "name": "Preset",
          "description": "Flat resets every band to 0 dB."
        }
      }
    },
    "send_raw": {
      "name": "Send raw command",
      "description": "Send one protocol command and return the reply. For reading something the integration does not model yet.",
      "fields": {
        "device_id": {
          "name": "Matrix",
          "description": "Which matrix to send to."
        },
        "command": {
          "name": "Command",
          "description": "Hex, starting FF 55. For example FF5504031EF500 reads output 1's volume."
        },
        "allow_write": {
          "name": "Allow writing",
          "description": "Required for any command without the F5 query marker. Those change the device, and it accepts out-of-range writes silently, so this is off by default."
        }
      }
    }
  }
